# ── Email OTP & Notifications (Resend API) ────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_EMAIL_FROM=billing@accountgo.dev
RESEND_FROM_NAME="AccountGo Billing"
AUTH_EMAIL_FROM=auth@accountgo.dev
SECURITY_EMAIL_FROM=security@accountgo.dev
INVITES_EMAIL_FROM=invites@accountgo.dev
SUPPORT_EMAIL=support@accountgo.dev
EMAIL_PROVIDER=Resend
PUBLIC_WEB_URL=http://localhost:5173
# Absolute API origin used in signed customer invoice PDF links (no trailing slash).
PUBLIC_API_URL=http://localhost:8001

# ── Security & Authentication ──────────────────────────────────
SECRET_KEY=<generate: openssl rand -hex 32>
# Dedicated key for /api/internal/* (D1 restore / build). Must differ from SECRET_KEY in production.
INTERNAL_SYNC_KEY=<generate: openssl rand -hex 32>

# ── Free-tier entitlements (optional; unset = unlimited / all plans self-service) ──
# Self-hosted community builds leave these unset. Hosted Cloud sets values via Worker vars.
# ENTITLEMENTS_ENABLED=false
# ENTITLEMENTS_SELF_SERVICE_PLANS=invoicing,accounting
# ENTITLEMENTS_FREE_SALES_DOCUMENTS_PER_MONTH=10
# ENTITLEMENTS_FREE_BILLS_PER_MONTH=10
# ENTITLEMENTS_FREE_SEATS=1
# ENTITLEMENTS_FREE_BANK_ACCOUNTS=2
# ENTITLEMENTS_FREE_OWNED_WORKSPACES=1

# ── Hosted billing (AccountGo.Billing module only; leave unset for community) ──
# BILLING_PROVIDER=stripe
# Kill switch for self-serve Checkout / Upgrade UI (default on when unset).
# BILLING_SUBSCRIPTIONS_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_INVOICING_PRO_MONTHLY=price_…
# STRIPE_PRICE_INVOICING_PRO_ANNUAL=price_…
# STRIPE_PRICE_ACCOUNTING_PRO_MONTHLY=price_…
# STRIPE_PRICE_ACCOUNTING_PRO_ANNUAL=price_…

# ── AccountGo Assistant (Anter AI) ─────────────────────────────
# Server-side only — never expose these to the browser / Vite env.
ANTER_BASE_URL=https://agents.anter.ai
ANTER_API_KEY=
ANTER_PROJECT_ID=
ANTER_AGENT_SLUG=accountgo-assistant
