{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=accountgo.db",
    "DefaultConnection": "Data Source={0};User ID={1};Password={2};Initial Catalog={3};TrustServerCertificate=yes;MultipleActiveResultSets=true;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8000",
      "https://localhost:8000",
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "JwtSettings": {
    "validIssuer": "AccountGo API",
    "validAudience": "http://localhost:8001",
    "expires": 15
  },
  "Email": {
    "Provider": "Console",
    "FromAddress": "no-reply@accountgo.ph",
    "FromName": "AccountGo Security"
  },
  "Anter": {
    "BaseUrl": "https://agents.anter.ai",
    "ApiKey": "",
    "ProjectId": "",
    "AgentSlug": "accountgo-assistant"
  }
}
