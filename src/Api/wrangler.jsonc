{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accountgo-api",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "containers": [
    {
      "class_name": "AccountGoApiContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTAINER",
        "class_name": "AccountGoApiContainer"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "accountgo-db",
      "database_id": "15c6ce9e-a459-49c5-9a03-d8ba9a63233b",
      "migrations_dir": "d1/migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountGoApiContainer"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "Production",
    "CONTAINER_NAME": "v7",
    "DatabaseProvider": "Sqlite",
    "EMAIL_PROVIDER": "Resend",
    "PUBLIC_WEB_URL": "https://app.accountgo.dev",
    "PUBLIC_API_URL": "https://api.accountgo.dev",
    "RESEND_EMAIL_FROM": "billing@marvinperez.com",
    "RESEND_FROM_NAME": "AccountGo",
    "JwtSettings__validIssuer": "AccountGo API",
    "JwtSettings__validAudience": "https://api.accountgo.dev",
    "Cors__AllowedOrigins__0": "https://app.accountgo.dev",
    "Cors__AllowedOrigins__1": "https://accountgo-web.anter.workers.dev",
    "ANTER_BASE_URL": "https://agents.anter.ai",
    "ANTER_PROJECT_ID": "abproj_1hAA2dKHr1L32cGDNgZQy",
    "ANTER_AGENT_SLUG": "accountgo-assistant"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}