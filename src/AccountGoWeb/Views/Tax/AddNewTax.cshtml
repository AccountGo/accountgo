@model Dto.TaxSystem.TaxForCreation
<style>
    tr th {
        color: var(--bs-white, #fff);
    }

    tr td,
    div.row {
        color: var(--bs-white, #fff);
    }
</style>

<form action="~/Tax/AddNewTax" method="post">
    <div class="col-sm-10">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">Code</div>
                    <div class="col-sm-8">
                        <input asp-for="TaxCode" class="form-control" type="text" placeholder="Code" />
                        <span asp-validation-for="TaxCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-sm-3">Tax Name</div>
                    <div class="col-sm-8">
                        <input asp-for="TaxName" class="form-control" type="text" placeholder="Tax Name" />
                        <span asp-validation-for="TaxName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-sm-3">Rate</div>
                    <div class="col-sm-8">
                        <input asp-for="Rate" class="form-control" type="number" step="any" placeholder="Rate" />
                        <span asp-validation-for="Rate" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-sm-3">G/L Code</div>
                    <div class="col-sm-8">
                        <select class="form-control mb-1" asp-for="SalesAccountId"
                                asp-items="@ViewBag.DebitAccounts"></select>
                        <small class="d-block mb-2">Debit account</small>
                        <span asp-validation-for="SalesAccountId" class="text-danger"></span>

                        <select class="form-control mb-1" asp-for="PurchaseAccountId"
                                asp-items="@ViewBag.CreditAccounts"></select>
                        <small class="d-block">Credit account</small>
                        <span asp-validation-for="PurchaseAccountId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <input id="btnSave" class="btn btn-primary btn-sm pull-left" type="submit" value="Save" />
        <a href="~/tax/taxes" class="btn btn-secondary btn-sm pull-left">Close</a>
    </div>
</form>
