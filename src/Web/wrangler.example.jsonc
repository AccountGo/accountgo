{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accountgo-web",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "accountgo-api"
    }
  ],
  "vars": {
    "API_HOST": "localhost:8001",
    // Observability: Server-Timing on proxied /api responses (default on when unset).
    "SERVER_TIMING_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
